# Copy to .env and adjust. docker compose reads .env automatically.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:8000,http://localhost:3000

# Teacher login (created automatically on first start)
DJANGO_SUPERUSER_USERNAME=teacher
DJANGO_SUPERUSER_PASSWORD=teacher123
DJANGO_SUPERUSER_EMAIL=teacher@example.com

# PostgreSQL
POSTGRES_DB=results
POSTGRES_USER=results
POSTGRES_PASSWORD=results
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
RESULT_CACHE_TTL=300
