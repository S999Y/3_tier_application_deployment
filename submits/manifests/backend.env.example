# Copy to backend.env and replace every placeholder value.
# backend.env is gitignored and must never be committed or submitted.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_SUPERUSER_USERNAME=teacher
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password
DJANGO_SUPERUSER_EMAIL=teacher@example.com

POSTGRES_DB=results
POSTGRES_USER=results
POSTGRES_PASSWORD=replace-with-the-same-strong-password
